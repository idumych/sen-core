# What the Linux packaging needs to know about SEN. Shell syntax: sourced by packaging/appimage/*.sh and the CI workflow.
APP_NAME="SEN"                         # the name of the AppImage
APP_CMD="sen"
APP_SIG="application/x-vnd.sen-labs.sen-server"
RDEF="src/resources/sen_server.rdef"
PLATFORMS="linux"                      # this branch is about Linux; Haiku packages come from sen-laboratories

VERSION="1.0.0-beta.5"
REVISION="1"

SUMMARY="The core of SEN, the semantic desktop: relations between files"
HOMEPAGE="https://github.com/idumych/sen-core"
GITHUB_REPO="idumych/sen-core"
LICENSE_NAME="MIT"
DESKTOP_CATEGORIES="Utility;"

# What it is built from: the versions that this release of the server was made for
SENTO_TAG="v1.0.0-beta.5"
ONI_TAG="v1.0.0-beta.5"
COSMOE_REPO=""                         # "" = idumych/hokku
COSMOE_TAG="tray-in-appimage"          # "" = its branch hokku. This one builds TrayExport without Hokku's apps

APPIMAGE_APT_EXTRA="libspdlog-dev libfmt-dev"
APPIMAGE_MUST_BUNDLE="libspdlog libfmt"
APPIMAGE_TRANSLATORS="PNG JPEG"        # the logos, and the pictures of the entity cards
